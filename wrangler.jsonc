{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mitrinium",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-29",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mitrinium",
      "database_id": "74522a97-4db0-4a07-8f25-aaa07fc4e333",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ADMIN_EMAILS": "dacxxxx100@gmail.com",
    "GOOGLE_CLIENT_ID": "362510513602-02te9hq8nptji10ojlrctn0dmqb2lanl.apps.googleusercontent.com"
  }
}
